# Prefer a dedicated bot token, or point DISCORD_ENV_FILE at an existing bot's .env.
DISCORD_BOT_TOKEN=
# Replace this example ID with your server's ID.
DISCORD_ALLOWED_GUILDS=100000000000000001
# DISCORD_ENV_FILE=/absolute/path/to/bot/.env
# Optional per-bot slash-command permissions; paths in this JSON are relative to it.
# DISCORD_COMMAND_APPLICATIONS_FILE=.local/command-applications.json
